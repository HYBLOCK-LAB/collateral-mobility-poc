-- The use right of one bundle (README §3). Each business version has its own
-- right contract: {bundle_id}:right:{version}. A confirmed transaction
-- consumes the current right and creates the next one for the counterparty.
-- The holder and the cosigner, the party that passed the right on, both sign,
-- so neither creates, archives, consumes or locks a right alone (README §3
-- lists the joint paths this leaves).
module Collateral.Right where

import Collateral.Types

template UseRight
  with
    runId : Text
    bundle : Bundle
    rightId : Text
    holder : Party
    cosigner : Party
    createdVersion : Int
    status : RightStatus
    allowedCommands : [UseCommand]
    predecessorRightId : Optional Text
    sourceRecordId : Optional Text
  where
    signatory holder, cosigner
    ensure holder /= cosigner && createdVersion >= 0 && (status == AVAILABLE || null allowedCommands)

    -- Replaces the right with its consumed form instead of only archiving it,
    -- so the consumed right stays readable in the snapshot (interface §8.2).
    -- A second consumption of the same right fails: the contract is gone.
    -- The next holder authorizes too, so the holder cannot consume the right
    -- alone; a confirmation choice carries the counterparty's authority from
    -- its signature on the agreement.
    choice Consume : ContractId UseRight
      with
        nextHolder : Party
      controller holder, nextHolder
      do
        assertMsg "the next holder is the holder" (nextHolder /= holder)
        assertMsg "the right is not available" (status == AVAILABLE)
        create this with status = CONSUMED; allowedCommands = []

    -- Replaces the right with its locked form when the holder allocates the
    -- bundle as CCP margin (README §3): the same right ID, LOCKED, no allowed
    -- command. The locking party authorizes too, so the holder cannot lock
    -- the right alone; AllocateMargin carries the CCP's authority from its
    -- signature on the margin call.
    choice Lock : ContractId UseRight
      with
        locker : Party
      controller holder, locker
      do
        assertMsg "the locker is the holder" (locker /= holder)
        assertMsg "the right is not available" (status == AVAILABLE)
        create this with status = LOCKED; allowedCommands = []
