# Copy to implementations/canton/.env (gitignored) and adjust paths for this machine.
# Never put passwords or tokens here: scripts generate them under
# $CANTON_STATE_DIR/secrets (mode 600, outside the repository).

# Where scripts/install-toolchain.sh put dpm, the Daml SDK and Canton.
# Default: ${XDG_DATA_HOME:-$HOME/.local/share}/collateral-mobility-poc/canton-tools
#CANTON_TOOLS_DIR=

# PostgreSQL data, node logs, generated identifiers and secrets.
# Default: ${XDG_DATA_HOME:-$HOME/.local/share}/collateral-mobility-poc/canton-state
#CANTON_STATE_DIR=

# Dedicated PostgreSQL 17 cluster port (127.0.0.1 only).
#CANTON_PG_PORT=5433

# Toolchain locations (Homebrew defaults on Apple silicon).
#CANTON_JAVA_HOME=/opt/homebrew/opt/openjdk@21
#CANTON_PG_BIN=/opt/homebrew/opt/postgresql@17/bin

# Python 3.12 used by scripts/adapter.sh setup to create .venv.
#CANTON_PYTHON=/opt/homebrew/bin/python3.12

# Root of <run_id>/events.jsonl written by the adapters (the runner's evidence_dir).
# Default: implementations/canton/logs
#CANTON_EVIDENCE_DIR=

# Seconds scripts/adapter.sh start waits for both adapters to finish warm-up.
#CANTON_ADAPTER_START_TIMEOUT=120

# Seconds a submission waits for its final result before the adapter answers
# 202 PENDING and keeps deciding it (interface §6.2). Must stay below the
# runner's HTTP timeout (5 s). Default 4.0, a development value until the
# common response wait is set with model A.
#CANTON_RESPONSE_WAIT=4.0
