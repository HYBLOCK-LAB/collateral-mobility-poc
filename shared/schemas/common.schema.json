{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyblock.invalid/schemas/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "actor": {
      "enum": [
        "BANK_A",
        "BANK_B",
        "BANK_C",
        "CCP"
      ]
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "unit": {
          "const": "KRW_FACE_VALUE"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "currency": {
          "const": "KRW"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "NOT_FOUND",
            "PRECONDITION_NOT_MET",
            "REQUEST_ID_CONFLICT",
            "VERSION_CONFLICT",
            "USE_NOT_PERMITTED",
            "RIGHT_UNAVAILABLE",
            "COLLATERAL_NOT_ELIGIBLE",
            "TEMPORARILY_UNAVAILABLE",
            "OUTCOME_UNKNOWN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "security_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "quantity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "unit": {
              "const": "KRW_FACE_VALUE"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "reference_value": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "currency": {
              "const": "KRW"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "bundle_id",
        "security_id",
        "quantity",
        "reference_value",
        "version"
      ],
      "additionalProperties": false
    },
    "agreement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "REPO"
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "seller": {
              "const": "BANK_A"
            },
            "buyer": {
              "const": "BANK_B"
            },
            "reuse_allowed": {
              "type": "boolean"
            }
          },
          "required": [
            "agreement_id",
            "type",
            "bundle_id",
            "seller",
            "buyer",
            "reuse_allowed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "LOAN"
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "lender": {
              "const": "BANK_B"
            },
            "borrower": {
              "const": "BANK_C"
            },
            "ccp_use_allowed": {
              "type": "boolean"
            },
            "collateral_condition": {
              "type": "object",
              "properties": {
                "collateral_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "conditions_met": {
                  "type": "boolean"
                },
                "provided": {
                  "type": "boolean"
                }
              },
              "required": [
                "collateral_id",
                "conditions_met",
                "provided"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "agreement_id",
            "type",
            "bundle_id",
            "lender",
            "borrower",
            "ccp_use_allowed",
            "collateral_condition"
          ],
          "additionalProperties": false
        }
      ]
    },
    "right": {
      "type": "object",
      "properties": {
        "right_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "holder": {
          "enum": [
            "BANK_A",
            "BANK_B",
            "BANK_C",
            "CCP"
          ]
        },
        "created_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "CONSUMED",
            "LOCKED"
          ]
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "enum": [
              "CONFIRM_REPO",
              "CONFIRM_LOAN",
              "ALLOCATE_MARGIN"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "predecessor_right_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "right_id",
        "bundle_id",
        "holder",
        "created_version",
        "status",
        "allowed_commands",
        "predecessor_right_id",
        "source_record_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CONSUMED",
                  "LOCKED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allowed_commands": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "type": {
          "enum": [
            "REPO",
            "LOAN"
          ]
        },
        "agreement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "parties": {
          "type": "array",
          "items": {
            "enum": [
              "BANK_A",
              "BANK_B",
              "BANK_C",
              "CCP"
            ]
          },
          "minItems": 2,
          "uniqueItems": true,
          "maxItems": 2
        },
        "status": {
          "const": "ACTIVE"
        }
      },
      "required": [
        "contract_id",
        "type",
        "agreement_id",
        "bundle_id",
        "parties",
        "status"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "obligation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "REPO_REPURCHASE_PAYMENT"
            },
            "debtor": {
              "const": "BANK_A"
            },
            "creditor": {
              "const": "BANK_B"
            },
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "target": {
              "type": "object",
              "properties": {
                "agreement_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                }
              },
              "required": [
                "agreement_id"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "OUTSTANDING"
            }
          },
          "required": [
            "obligation_id",
            "type",
            "debtor",
            "creditor",
            "contract_id",
            "agreement_id",
            "target",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "REPO_SECURITIES_RETURN"
            },
            "debtor": {
              "const": "BANK_B"
            },
            "creditor": {
              "const": "BANK_A"
            },
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "target": {
              "type": "object",
              "properties": {
                "security_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "unit": {
                      "const": "KRW_FACE_VALUE"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "security_id",
                "quantity"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "OUTSTANDING"
            }
          },
          "required": [
            "obligation_id",
            "type",
            "debtor",
            "creditor",
            "contract_id",
            "agreement_id",
            "target",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "LOAN_SECURITIES_RETURN"
            },
            "debtor": {
              "const": "BANK_C"
            },
            "creditor": {
              "const": "BANK_B"
            },
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "target": {
              "type": "object",
              "properties": {
                "security_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "unit": {
                      "const": "KRW_FACE_VALUE"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "security_id",
                "quantity"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "OUTSTANDING"
            }
          },
          "required": [
            "obligation_id",
            "type",
            "debtor",
            "creditor",
            "contract_id",
            "agreement_id",
            "target",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "obligation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": {
              "const": "LOAN_COLLATERAL_RETURN_OR_RELEASE"
            },
            "debtor": {
              "const": "BANK_B"
            },
            "creditor": {
              "const": "BANK_C"
            },
            "contract_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "agreement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "target": {
              "type": "object",
              "properties": {
                "collateral_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "agreement_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                }
              },
              "required": [
                "collateral_id",
                "agreement_id"
              ],
              "additionalProperties": false
            },
            "status": {
              "const": "OUTSTANDING"
            }
          },
          "required": [
            "obligation_id",
            "type",
            "debtor",
            "creditor",
            "contract_id",
            "agreement_id",
            "target",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "allocation": {
      "type": "object",
      "properties": {
        "allocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "margin_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "provider": {
          "const": "BANK_C"
        },
        "ccp": {
          "const": "CCP"
        },
        "status": {
          "const": "LOCKED"
        }
      },
      "required": [
        "allocation_id",
        "margin_call_id",
        "bundle_id",
        "provider",
        "ccp",
        "status"
      ],
      "additionalProperties": false
    },
    "marginCall": {
      "type": "object",
      "properties": {
        "margin_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "provider": {
          "const": "BANK_C"
        },
        "ccp": {
          "const": "CCP"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "whole_bundle_accepted": {
          "type": "boolean"
        },
        "eligibility_passed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "OPEN",
            "SATISFIED"
          ]
        }
      },
      "required": [
        "margin_call_id",
        "provider",
        "ccp",
        "bundle_id",
        "whole_bundle_accepted",
        "eligibility_passed",
        "status"
      ],
      "additionalProperties": false
    },
    "pendingOperation": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "kind": {
          "enum": [
            "PROCESSING",
            "RECOVERING",
            "REASSIGNING"
          ]
        },
        "blocks_use": {
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "bundle_id",
        "kind",
        "blocks_use"
      ],
      "additionalProperties": false
    }
  }
}
